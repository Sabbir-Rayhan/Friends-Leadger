# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret for sessions. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL="http://localhost:3000"

# OPTIONAL: Google login. Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
